<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bg_app_stats"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight">

    <FrameLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/total_today"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="?android:attr/textColorSecondary" />

            <ImageView
                android:id="@+id/refresh_stats_screentime"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/desc_refresh_stats"
                android:padding="5dp"
                android:src="@drawable/baseline_refresh_24"
                android:tint="?android:attr/colorAccent" />
        </LinearLayout>

        <TextView
            android:id="@+id/screentime_widget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/coolvetica_rg"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/value_zero_time"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="38sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/app_row_1"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_1"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_1"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_1"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_2"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_2"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_2"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_2"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_3"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_3"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_3"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_3"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_4"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_4"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_4"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_4"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_5"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_5"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_5"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_5"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_6"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_6"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_6"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_6"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_7"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_7"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_7"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_7"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/app_row_8"
            style="@style/UsageWidgetAppRow"
            android:visibility="gone">

            <ImageView
                android:id="@+id/app_icon_8"
                style="@style/UsageWidgetAppIcon" />

            <TextView
                android:id="@+id/app_name_8"
                style="@style/UsageWidgetAppName" />

            <TextView
                android:id="@+id/app_usage_8"
                style="@style/UsageWidgetAppTime" />
        </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
